# LLM provider: auto | gemini | mock
# auto = use Gemini if GEMINI_API_KEY is set, otherwise fall back to the
# deterministic mock provider (demo mode). Leave this as "auto" unless you
# want to force one or the other.
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional tuning
MAX_ACTIONS=25
MAX_SESSION_SECONDS=180
MAX_NAVIGATIONS=10
ACTION_TIMEOUT_MS=8000
# Set to false to watch the browser while a session runs (debugging only).
BROWSER_HEADLESS=true

# Advanced: only needed if you serve the backend on a non-default host/port.
# PORT=8000
# DEMO_SITE_URL=http://localhost:8000/api/demo-site/
